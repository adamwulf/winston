<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The required-reason APIs Winston's own code uses. Its packages' dependencies (TDLib,
	     speech-swift and the rest) aren't covered here.
	     - File timestamps (C617.1): the dates of files in its own containers, the App Group's
	       included: ShareOutbox orders shared files and finds leftovers, and OpenedFile finds
	       opened files' leftovers.
	     - User defaults (CA92.1): its settings, read and written by the app alone.
	     - System boot time (35F9.1): the voice loop's timeline and media logs measure the time
	       between events in the app. Only those intervals may leave the device under this
	       reason, as in the logs Export Debug Logs shares. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
