// Build settings shared by every configuration of the Winston app target.

// Versions live here, not in the project file, so Xcode Cloud's ci_pre_xcodebuild.sh can
// stamp CURRENT_PROJECT_VERSION with its build number.
VERSIONING_SYSTEM = apple-generic
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

// Must match the signed app's aps-environment entitlement. Override for a Release build
// installed with a development profile, or a Debug build exported for distribution.
PUSH_ENVIRONMENT = production
PUSH_ENVIRONMENT[config=Debug] = development

// With Info.plist's document types. NO on iOS: iOS hands Winston a copy of a file opened in it,
// in one of its inboxes, which Winston removes once the file is sent or cancelled, rather than
// the file in place. App Store Connect
// warns about an iOS app with document types that leaves this out (ITMS-90737). YES on the Mac,
// which hands over the file itself: the Mac build refuses NO, and without a Mac value of its own
// it fails the same way, as of Xcode 27.2.
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[sdk=iphoneos*] = NO
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[sdk=iphonesimulator*] = NO
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[sdk=macosx*] = YES

// Push is off: the App ID doesn't have Push Notifications yet, so no profile carries
// aps-environment and App Store export fails. Config/iOS.entitlements holds that entitlement
// but isn't signed in. To turn push on, follow plans/enable-push.md.

// Telegram API credentials from https://my.telegram.org (API development tools).
// Real values go in Secrets.xcconfig, which is gitignored. Copy Secrets.example.xcconfig to start.
// Xcode Cloud writes it from its TG_API_ID / TG_API_HASH environment variables (ci_post_clone.sh).
TG_API_ID = 0
TG_API_HASH =

// After the defaults, so its values win.
#include? "Secrets.xcconfig"
